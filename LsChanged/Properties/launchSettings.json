{
  "profiles": {
    "Linux (WSL)": {
      "commandName": "WSL2",
      "commandLineArgs": "{OutDir}/LsChanged.dll /proc /mnt/c/TEMP/files-wsl.json"
    },
    "LsChanged scan": {
      "commandName": "Project",
      "commandLineArgs": "-s C:\\TEMP\\LsChangedStore scan C:\\ -fs 1"
    },
    "LsChanged compare": {
      "commandName": "Project",
      "commandLineArgs": "-s C:\\TEMP\\LsChangedStore compare c:\\temp\\compare.txt -cm 0,10 -rp C:\\"
    },
    "LsChanged list": {
      "commandName": "Project",
      "commandLineArgs": "-s C:\\TEMP\\LsChangedStore list"
    },
    "LsChanged clear": {
      "commandName": "Project",
      "commandLineArgs": "-s C:\\TEMP\\LsChangedStore clear -v"
    },
    "LsChanged delete": {
      "commandName": "Project",
      "commandLineArgs": "-s C:\\TEMP\\LsChangedStore delete last"
    }
  }
}